{
  "name": "universal-git-repository-manager",
  "displayName": "Universal Git Repository Manager",
  "description": "Browse, edit, and manage selected external Git repositories from a dedicated VS Code sidebar.",
  "version": "0.1.3",
  "publisher": "mbahau",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["SCM Providers", "Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onView:universalGitManager.repositories", "onView:universalGitManager.files", "onCommand:universalGitManager.fetch"],
  "contributes": {
    "configuration": { "title": "Universal Git Manager", "properties": {
      "universalGitManager.rootPath": { "type": "string", "default": "", "description": "Git repository root. Windows paths are converted for Remote WSL when possible." },
      "universalGitManager.wslRootPath": { "type": "string", "default": "", "description": "Optional WSL override for rootPath." },
      "universalGitManager.defaultRepositories": { "type": "array", "default": [], "items": { "type": "string" }, "description": "Repository names to select automatically during the first discovery." },
      "universalGitManager.autoDiscoverOnStartup": { "type": "boolean", "default": false },
      "universalGitManager.restoreSelections": { "type": "boolean", "default": true },
      "universalGitManager.scanDepth": { "type": "number", "default": 1, "minimum": 1, "maximum": 5 }
    } },
    "viewsContainers": { "activitybar": [{ "id": "universalGitManager", "title": "Git Repositories", "icon": "resources/repository.svg" }] },
    "views": { "universalGitManager": [{ "id": "universalGitManager.repositories", "name": "Available Repositories" }, { "id": "universalGitManager.files", "name": "Selected Repositories" }] },
    "commands": [
      { "command": "universalGitManager.setup", "title": "Universal Git Manager: Initial Setup" }, { "command": "universalGitManager.fetch", "title": "Universal Git Manager: Fetch Repositories", "icon": "$(cloud-download)" }, { "command": "universalGitManager.refresh", "title": "Universal Git Manager: Refresh Repositories", "icon": "$(refresh)" }, { "command": "universalGitManager.configureRoot", "title": "Universal Git Manager: Configure Repository Root", "icon": "$(gear)" }, { "command": "universalGitManager.select", "title": "Universal Git Manager: Select Repository", "icon": "$(check)" }, { "command": "universalGitManager.deselect", "title": "Universal Git Manager: Deselect Repository", "icon": "$(circle-slash)" }, { "command": "universalGitManager.selectAll", "title": "Universal Git Manager: Select All Repositories", "icon": "$(check-all)" }, { "command": "universalGitManager.deselectAll", "title": "Universal Git Manager: Deselect All Repositories", "icon": "$(clear-all)" }, { "command": "universalGitManager.restoreDefaults", "title": "Universal Git Manager: Restore Default Repositories" }, { "command": "universalGitManager.openRepositoryFiles", "title": "Universal Git Manager: Open Repository Files" }, { "command": "universalGitManager.openTerminal", "title": "Universal Git Manager: Open Repository in Terminal" }, { "command": "universalGitManager.addWorkspace", "title": "Universal Git Manager: Add Repository to Workspace" }, { "command": "universalGitManager.openNewWindow", "title": "Universal Git Manager: Open Repository in New Window" }, { "command": "universalGitManager.copyPath", "title": "Universal Git Manager: Copy Repository Path" }, { "command": "universalGitManager.status", "title": "Universal Git Manager: Show Git Status" }, { "command": "universalGitManager.gitFetch", "title": "Universal Git Manager: Git Fetch" }, { "command": "universalGitManager.gitPull", "title": "Universal Git Manager: Git Pull" }, { "command": "universalGitManager.enableSourceControl", "title": "Universal Git Manager: Enable Selected in Source Control", "icon": "$(source-control)" }, { "command": "universalGitManager.disableSourceControl", "title": "Universal Git Manager: Disable Selected in Source Control", "icon": "$(close)" }, { "command": "universalGitManager.openFile", "title": "Universal Git Manager: Open File" }, { "command": "universalGitManager.copyRelativePath", "title": "Universal Git Manager: Copy Relative Path" }, { "command": "universalGitManager.openContainingFolder", "title": "Universal Git Manager: Open Containing Folder" }
    ],
    "menus": { "view/title": [{ "command": "universalGitManager.configureRoot", "when": "view == universalGitManager.repositories", "group": "navigation@0" }, { "command": "universalGitManager.fetch", "when": "view == universalGitManager.repositories", "group": "navigation@1" }, { "command": "universalGitManager.refresh", "when": "view == universalGitManager.repositories", "group": "navigation@2" }, { "command": "universalGitManager.selectAll", "when": "view == universalGitManager.repositories", "group": "navigation@3" }, { "command": "universalGitManager.deselectAll", "when": "view == universalGitManager.repositories", "group": "navigation@4" }], "view/item/context": [{ "command": "universalGitManager.select", "when": "view == universalGitManager.repositories && viewItem == ugmRepoUnselected", "group": "inline@1" }, { "command": "universalGitManager.deselect", "when": "view == universalGitManager.repositories && viewItem == ugmRepoSelected", "group": "inline@1" }, { "command": "universalGitManager.openRepositoryFiles", "when": "viewItem =~ /ugmRepo/", "group": "repo@1" }, { "command": "universalGitManager.openTerminal", "when": "viewItem =~ /ugmRepo/", "group": "repo@2" }, { "command": "universalGitManager.addWorkspace", "when": "viewItem =~ /ugmRepo/", "group": "repo@3" }, { "command": "universalGitManager.status", "when": "viewItem =~ /ugmRepo/", "group": "repo@4" }, { "command": "universalGitManager.enableSourceControl", "when": "viewItem =~ /ugmRepo/", "group": "repo@5" }, { "command": "universalGitManager.gitFetch", "when": "viewItem =~ /ugmRepo/", "group": "git@1" }, { "command": "universalGitManager.gitPull", "when": "viewItem =~ /ugmRepo/", "group": "git@2" }, { "command": "universalGitManager.openFile", "when": "viewItem == ugmFile", "group": "inline@1" }, { "command": "universalGitManager.copyPath", "when": "viewItem == ugmFile", "group": "file@1" }, { "command": "universalGitManager.copyRelativePath", "when": "viewItem == ugmFile", "group": "file@2" }, { "command": "universalGitManager.openContainingFolder", "when": "viewItem == ugmFile", "group": "file@3" }] }
  },
  "scripts": { "package": "npx @vscode/vsce package --no-dependencies" },
  "devDependencies": { "@vscode/vsce": "^3.0.0" }
}
